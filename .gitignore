.env

# Generated video files
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.gif

# Generated sound files
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.m4a
*.aiff

# --- Render sandbox artifacts (regenerated by tapes/render-*.sh) ---

# Headless browser profiles captured during demo runs (Chrome caches, tflite models)
**/.rysh/browser-instances/*/headless/

# QC frame dumps from render passes
qc/
qc-*/
**/edit/fqc*.png
**/edit/seam-*.png

# Compiled binaries produced inside sandboxes
tapes/render-sandbox*/bin
tapes/render-sandbox*/bin/
tapes/render-sandbox*/**/bin
tapes/render-sandbox-ad04/owner/billing-api
tapes/render-sandbox-ad04/team/billing-api

# Run logs
*.log

# Sandbox configs holding a live workspace api_key (see demos/remote-reach/rysh.config.yaml.example)
tapes/render-sandbox-ad04/owner/rysh.config.yaml
tapes/render-sandbox-ad04/team/rysh.config.yaml
